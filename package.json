{
  "name": "music-dl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Music download desktop interaction prototype with vanilla JavaScript, Vite and Neutralinojs",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm test && pnpm build",
    "desktop:setup": "neu update",
    "desktop:dev": "pnpm build && neu run",
    "desktop:build": "pnpm build && neu build --release"
  },
  "dependencies": {
    "@neutralinojs/lib": "6.10.0"
  },
  "devDependencies": {
    "@neutralinojs/neu": "11.8.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "vite": "8.3.5",
    "vitest": "^4.0.0"
  }
}
