{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "io.musicservice.shiyin",
  "applicationName": "曲袋",
  "description": "曲袋 · 音乐下载",
  "applicationIcon": "dist/app/app-icon.png",
  "version": "0.1.6",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist/app/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "exportAuthInfo": false,
  "nativeAllowList": [
    "app.exit",
    "os.open",
    "os.getPath",
    "os.execCommand",
    "os.spawnProcess",
    "os.updateSpawnedProcess",
    "filesystem.getJoinedPath",
    "filesystem.getStats",
    "filesystem.access",
    "filesystem.createDirectory",
    "filesystem.readFile",
    "filesystem.readDirectory",
    "filesystem.copy",
    "filesystem.readBinaryFile",
    "filesystem.writeFile",
    "filesystem.move",
    "filesystem.remove",
    "resources.extractFile",
    "storage.getData",
    "storage.setData"
  ],
  "modes": {
    "window": {
      "title": "曲袋 · 音乐下载",
      "icon": "/dist/app/app-icon.png",
      "width": 540,
      "height": 820,
      "minWidth": 500,
      "minHeight": 640,
      "center": true,
      "resizable": true,
      "useSavedState": false,
      "injectGlobals": true,
      "enableInspector": false,
      "exitProcessOnClose": false
    }
  },
  "cli": {
    "binaryName": "qudai",
    "resourcesPath": "/dist/app/",
    "distributionPath": "/release/",
    "binaryVersion": "6.10.0"
  }
}
